# Pin immutable coordinates before deployment. Mutable image tags and catalog
# channels are not deployment authority.
RYEOS_SUBSTRATE_IMAGE=ghcr.io/leolilley/ryeos-substrate@sha256:REPLACE_WITH_64_HEX_DIGEST
RYEOS_SUBSTRATE_PROTOCOL=1
# Host class whose signed capability floor the node holds: `hosted` for a
# hosting provider's container, `local` (or `local_unconfined`) on a host the
# operator runs. Required whenever the entrypoint initializes from the image's
# profile, and fixed for the node's life once initialized.
RYEOS_INIT_HOST_CLASS=hosted
RYEOS_NODE_BUNDLE_SELECTION_HASH=REPLACE_WITH_64_HEX_CAS_HASH
RYEOS_NODE_BUNDLE_SELECTION_AUTHORIZATION_HASH=REPLACE_WITH_64_HEX_CAS_HASH
RYEOS_BUNDLE_PUBLICATION_POLICY_SECTION_DIGEST=REPLACE_WITH_64_HEX_DIGEST
RYEOS_NODE_POLICY_GENERATION_DIGEST=REPLACE_WITH_64_HEX_DIGEST
RYEOS_CATALOG_NAMESPACE=official
# Optional pre-start bundle update. Absolute path to a stopped
# `ryeos node bundle-set update` request file inside the container. When set,
# the entrypoint runs the update before every ryeosd start; a failed update
# refuses the start, an already-current node proceeds. Unset = no update.
#RYEOS_PRESTART_BUNDLE_SET_REQUEST=/data/bundle-set-update-request.yaml
