# Explicit external constrained-publisher client. Both values are required
# together; omit both to leave publisher operations unavailable.
# HTTPS is required except for a loopback development sidecar.
RYEOS_BUNDLE_PUBLISHER_URL=https://publisher.example.invalid/
# Inject this secret through the deployment secret store. Never commit a value.
RYEOS_BUNDLE_PUBLISHER_BEARER=
# Normal publication names a pinned RyeOS remote (normally `bundle-source`) in
# the release request. Configure that remote with `ryeos remote configure` so
# its URL, node principal/signing key, site identity, and vault identity are
# authenticated. There is intentionally no separate bundle-source bearer here.
