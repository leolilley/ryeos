{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.retried"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "attempt": {
          "type": "number"
        },
        "error": {
          "$ref": "#/$defs/SessionNextRetry_error"
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "attempt",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SessionNextRetry_error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "statusCode": {
          "type": "number"
        },
        "isRetryable": {
          "type": "boolean"
        },
        "responseHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "responseBody": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "message",
        "isRetryable"
      ],
      "additionalProperties": false
    }
  }
}
