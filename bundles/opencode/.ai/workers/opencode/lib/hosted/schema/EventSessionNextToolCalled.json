{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.tool.called"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "assistantMessageID": {
          "type": "string",
          "pattern": "^msg_"
        },
        "callID": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "provider": {
          "type": "object",
          "properties": {
            "executed": {
              "type": "boolean"
            },
            "metadata": {
              "$ref": "#/$defs/LLMProviderMetadata"
            }
          },
          "required": [
            "executed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "assistantMessageID",
        "callID",
        "tool",
        "input",
        "provider"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LLMProviderMetadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
