{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.reasoning.ended"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "assistantMessageID": {
          "type": "string",
          "pattern": "^msg_"
        },
        "reasoningID": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "providerMetadata": {
          "$ref": "#/$defs/LLMProviderMetadata"
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "assistantMessageID",
        "reasoningID",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LLMProviderMetadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
