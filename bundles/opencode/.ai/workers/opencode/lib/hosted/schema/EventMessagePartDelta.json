{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "message.part.delta"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "messageID": {
          "type": "string",
          "pattern": "^msg"
        },
        "partID": {
          "type": "string",
          "pattern": "^prt"
        },
        "field": {
          "type": "string"
        },
        "delta": {
          "type": "string"
        }
      },
      "required": [
        "sessionID",
        "messageID",
        "partID",
        "field",
        "delta"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
