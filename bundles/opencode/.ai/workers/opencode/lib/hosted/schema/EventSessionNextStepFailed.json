{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.step.failed"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "assistantMessageID": {
          "type": "string",
          "pattern": "^msg_"
        },
        "error": {
          "$ref": "#/$defs/SessionErrorUnknown"
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "assistantMessageID",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SessionErrorUnknown": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
