{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.moved"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "location": {
          "$ref": "#/$defs/LocationRef"
        },
        "subdirectory": {
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "location"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LocationRef": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "workspaceID": {
          "type": "string",
          "pattern": "^wrk"
        }
      },
      "required": [
        "directory"
      ],
      "additionalProperties": false
    }
  }
}
