{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.next.compaction.ended"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "number"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "messageID": {
          "type": "string",
          "pattern": "^msg_"
        },
        "reason": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "text": {
          "type": "string"
        },
        "recent": {
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "sessionID",
        "messageID",
        "reason",
        "text",
        "recent"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
