{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "type": "string",
      "enum": [
        "permission.asked"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^per"
        },
        "sessionID": {
          "type": "string",
          "pattern": "^ses"
        },
        "permission": {
          "type": "string"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "always": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "type": "object",
          "properties": {
            "messageID": {
              "type": "string"
            },
            "callID": {
              "type": "string"
            }
          },
          "required": [
            "messageID",
            "callID"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "sessionID",
        "permission",
        "patterns",
        "metadata",
        "always"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "properties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
