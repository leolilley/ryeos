      "method": "turn/completed",
      "schema": "schema/TurnCompletedNotification.json",
      "event_type": "turn.completed",
      "durable": true,
      "payload": {
        "op": "object",
        "fields": {
          "session_id": {
            "op": "pointer",
            "pointer": "/message/params/session_id",
            "max_string_bytes": 256
          },
          "turn_id": {
            "op": "pointer",
            "pointer": "/message/params/completed_turn_id",
            "max_string_bytes": 256
          },
          "status": {
            "op": "pointer",
            "pointer": "/message/params/status",
            "max_string_bytes": 256
          },
          "result": {
            "op": "pointer",
            "pointer": "/message/params/result",
            "max_string_bytes": 262144
          }
        }
      },
      "observations": [
        {
          "when": [],
          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "state"
              },
              "expected": {
                "op": "literal",
                "value": "turn_running"
              },
              "next": {
                "op": "literal",
                "value": "idle"
              },
              "completed_turn_id": {
                "op": "pointer",
                "pointer": "/message/params/completed_turn_id",
                "max_string_bytes": 256
              }
            }
          }
        }
      ],
      "ceremony_clear": false,
      "result": true,
      "result_cost": {
        "input_tokens": "/result/usage/input_tokens",
        "output_tokens": "/result/usage/output_tokens",
        "cost_micro_usd": "/result/usage/cost_micro_usd"
      },
      "result_status": {
        "pointer": "/status",
        "failure_values": [
          "crashed",
          "failed"
        ]
      },
      "upstream_session_pointer": "/message/params/session_id"
    },
    {
      "method": "turn/started",
      "schema": "schema/TurnStartedNotification.json",
      "event_type": "turn.started",
