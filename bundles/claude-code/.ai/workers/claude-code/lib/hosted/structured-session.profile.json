          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "state"
              },
              "expected": {
                "op": "literal",
                "value": "idle"
              },
              "next": {
                "op": "literal",
                "value": "turn_running"
