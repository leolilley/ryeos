{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnProgressNotification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "message",
    "sequence",
    "session_id",
    "turn_id"
  ]
}
