{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionStartResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "access": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write"
      ]
    }
  },
  "required": [
    "access",
    "session_id"
  ]
}
