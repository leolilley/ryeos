{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionReadResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "lost"
      ]
    }
  },
  "required": [
    "session_id",
    "state"
  ]
}
