{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnCompletedNotification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "completed_turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "crashed",
        "failed",
        "interrupted"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 131072
        },
        "truncated": {
          "type": "boolean"
        },
        "structured_output": {},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_micro_usd": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "cost_micro_usd",
            "input_tokens",
            "output_tokens"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        },
        "usage_source": {
          "type": "string",
          "enum": [
            "result",
            "messages"
          ]
        },
        "usage_by_model": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ]
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "declared": {
              "type": [
                "string",
                "null"
              ]
            },
            "called": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "structured_output",
        "text",
        "truncated",
        "usage"
      ]
    }
  },
  "required": [
    "completed_turn_id",
    "result",
    "session_id",
    "status"
  ]
}
