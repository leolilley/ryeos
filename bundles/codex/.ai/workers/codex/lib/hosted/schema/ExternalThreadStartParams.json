{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "title": "ExternalThreadStartParams",
  "description": "Finite external-only start after owner route injection; callers cannot override fixed fields.",
  "properties": {
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "approvalsReviewer": {
      "const": "user"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environmentId": {
            "const": "ryeos-external-candidate"
          },
          "cwd": {
            "const": "/workspace"
          },
          "runtimeWorkspaceRoots": {
            "const": [
              "/workspace"
            ]
          }
        },
        "required": [
          "environmentId",
          "cwd",
          "runtimeWorkspaceRoots"
        ]
      }
    },
    "experimentalRawEvents": {
      "type": "boolean"
    },
    "model": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[^!-~]"
          }
        }
      ]
    }
  },
  "required": [
    "cwd",
    "approvalsReviewer",
    "environments"
  ]
}
