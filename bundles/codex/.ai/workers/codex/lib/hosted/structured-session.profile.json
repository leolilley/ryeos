{
  "schema_version": 1,
  "configuration_authority": "immutable_argv",
  "workload_realization_id": "codex",
  "workload_executable": "codex",
  "workload_args": [
    "--strict-config",
    "-c", "forced_login_method=\"chatgpt\"",
    "-c", "cli_auth_credentials_store=\"file\"",
    "-c", "model_provider=\"openai\"",
    "-c", "mcp_servers={}",
    "-c", "check_for_update_on_startup=false",
    "-c", "approval_policy={ granular={ sandbox_approval=true, rules=false, mcp_elicitations=false, request_permissions=false, skill_approval=false } }",
    "-c", "approvals_reviewer=\"user\"",
    "-c", "default_permissions=\"ryeos-workspace-only\"",
    "-c", "web_search=\"disabled\"",
    "-c", "allow_login_shell=false",
    "-c", "shell_environment_policy={ inherit=\"core\", ignore_default_excludes=false, filters={ \"HOME\"=\"exclude\", \"CODEX_HOME\"=\"exclude\", \"RYEOS_*\"=\"exclude\", \"DBUS_*\"=\"exclude\", \"SSH_*\"=\"exclude\", \"*PROXY\"=\"exclude\" } }",
    "-c", "permissions={ ryeos-workspace-only={ extends=\":workspace\", filesystem={ \":root\"=\"deny\", \":minimal\"=\"read\", \":tmpdir\"=\"deny\", \":slash_tmp\"=\"deny\", \":workspace_roots\"={ \".ai/cache/ryeos-runtime\"=\"read\" } }, network={ enabled=false } } }",
    "-c", "agents={ enabled=false }",
    "-c", "features={ apps=false, remote_plugin=false, hooks=false, multi_agent=false, memories=false, network_proxy=false, code_mode_host=true, code_mode={ enabled=false } }",
    "app-server"
  ],
  "workload_home_env": "CODEX_HOME",
  "baseline_config": "baseline.config.toml",
  "baseline_destination": "config.toml",
  "initialization": [
    {
      "method": "initialize",
      "effect_class": "pure_read",
      "params": {
        "clientInfo": {
          "name": "ryeos",
          "title": "RyeOS Hosted Workload",
          "version": "1"
        }
      },
      "response_schema": "schema/InitializeResponse.json",
      "notification": null
    },
    {
      "method": "initialized",
      "effect_class": "pure_read",
      "params": {},
      "response_schema": null,
      "notification": "initialized"
    }
  ],
  "route_sets": {
    "enrollment": [
      "credential.account.read",
      "credential.login.cancel",
      "credential.login.start"
    ],
    "session": [
      "credential.account.read",
      "credential.rate_limits.read",
      "model.list",
      "session.read",
      "session.resume",
      "session.start",
      "turn.interrupt",
      "turn.start",
      "turn.steer"
    ]
  },
  "routes": [
    {
      "id": "credential.login.start",
      "method": "account/login/start",
      "effect_class": "credential_write",
      "request_schema": "schema/LoginAccountParams.json",
      "response_schema": "schema/LoginAccountResponse.json",
      "fixed_params": {
        "type": "chatgptDeviceCode"
      },
      "workspace_fields": [],
      "forbidden_non_null_fields": [
        "apiKey",
        "accessToken",
        "chatgptAccountId",
        "chatgptPlanType"
      ],
      "observations": [
        {
          "when": [
            {
              "pointer": "/response/result/type",
              "equals": "chatgptDeviceCode"
            }
          ],
          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "credential_enrollment_started"
              },
              "login_id": {
                "op": "pointer",
                "pointer": "/response/result/loginId"
              },
              "ttl_seconds": {
                "op": "literal",
                "value": 900
              }
            }
          }
        }
      ],
      "result_retention": "ephemeral",
      "ceremony": "start",
      "response_predicates": []
    },
    {
      "id": "credential.login.cancel",
      "method": "account/login/cancel",
      "effect_class": "credential_write",
      "request_schema": "schema/CancelLoginAccountParams.json",
      "response_schema": "schema/CancelLoginAccountResponse.json",
      "fixed_params": {},
      "workspace_fields": [],
      "forbidden_non_null_fields": [],
      "observations": [
        {
          "when": [],
          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "credential_enrollment_cancelled"
              },
              "login_id": {
                "op": "pointer",
                "pointer": "/params/loginId"
              }
            }
          }
        }
      ],
      "result_retention": "ephemeral",
      "ceremony": "clear",
      "response_predicates": []
    },
    {
      "id": "credential.account.read",
      "method": "account/read",
      "effect_class": "credential_read",
      "request_schema": "schema/GetAccountParams.json",
      "response_schema": "schema/GetAccountResponse.json",
      "fixed_params": {
        "refreshToken": false
