      ],
      "forbidden_non_null_fields": [
        "config",
        "baseInstructions",
        "serviceName",
        "modelProvider",
        "sandbox"
      ],
      "observations": [
        {
          "when": [],
          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "remote_thread"
              },
              "id": {
                "op": "pointer",
                "pointer": "/response/result/thread/id",
                "max_string_bytes": 256
              }
            }
          }
        }
      ],
      "result_retention": "ephemeral",
      "ceremony": null,
      "session_binding": {
        "action": "bind_new",
        "request_field": null,
        "response_pointer": "/result/thread/id"
      },
      "response_predicates": [
        {
          "pointer": "/response/result/activePermissionProfile/id",
          "equals": "ryeos-workspace-only"
        },
        {
          "pointer": "/response/result/approvalsReviewer",
          "equals": "user"
        },
        {
          "pointer": "/response/result/sandbox/networkAccess",
          "equals": false
        }
      ]
    },
    {
