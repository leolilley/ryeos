          "value": {
            "op": "object",
            "fields": {
              "kind": {
                "op": "literal",
                "value": "credential_enrollment_observed"
              },
              "account": {
                "op": "object",
                "fields": {
                  "type": {
                    "op": "literal",
                    "value": "chatgpt"
                  },
                  "email": {
                    "op": "pointer",
                    "pointer": "/response/result/account/email",
                    "optional": true,
                    "max_string_bytes": 4096
                  },
                  "plan_type": {
                    "op": "pointer",
                    "pointer": "/response/result/account/planType",
                    "optional": true,
                    "max_string_bytes": 4096
                  }
                }
              }
            }
          }
        }
      ],
      "result_retention": "ephemeral",
      "ceremony": "clear",
      "response_predicates": []
    },
    {
      "id": "credential.rate_limits.read",
      "method": "account/rateLimits/read",
