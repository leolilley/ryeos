{
  "schema": 1,
  "provider_profile": "render_sandbox_v1",
  "origin_profile": "render_api_v1",
  "routes": {
    "source_status": ["v1", "sandboxes", "{source_sandbox_id}"],
    "upload_token": ["v1", "sandboxes", "{source_sandbox_id}", "files", "upload", "token"],
    "create_snapshot": ["v1", "sandboxes", "{source_sandbox_id}", "snapshots"],
    "get_snapshot": ["v1", "sandbox-groups", "{sandbox_group_id}", "snapshots", "{snapshot_id}"]
  },
  "operations": {
    "upload_content_type": "application/x-tar",
    "upload_path": "/ryeos/guest-runtime",
    "create_kind": "filesystem",
    "create_status": 202,
    "get_status": 200,
    "readiness_state": "available"
  }
}
