# syntax=docker/dockerfile:1.7
#
# One release solve owns compilation and official bundle publication. The
# native archive and every runtime image below derive from that exact published
# generation. Node binaries additionally select the native scheduler composition
# appropriate to the final stage's declared bundle set.

# Only qualification builds may select the development publication.
# Official archives always depend on the checked published stage, and an
# official image build leaves PUBLICATION_STAGE at its published default.
ARG CONTAINED_PUBLICATION_STAGE=published
# The composition images select their publication the same way: `published` for official images,
# `development-publication` for candidate builds signed with a development key.
ARG PUBLICATION_STAGE=published
FROM rust:1.95-slim@sha256:e14e87345b4d5964ddcc3491d27ee046a0f23820f340c3c1e24da6880141f7c0 AS compiled-publication

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gzip openssl pkg-config libssl-dev tar xz-utils \
        libcap-dev binutils python3 python3-yaml python3-cryptography && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

ARG VERSION
ARG SOURCE_DATE_EPOCH
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
ARG PUBLISHER_OWNER=ryeos-official
ENV RYEOS_VCS_REF=$VCS_REF
ENV RYEOS_BUILD_DATE=$BUILD_DATE
ENV RYEOS_BUILD_VERSION=$VERSION
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH

# COPY-provided bundle directories can live in a lower overlay rename domain.
# Materialize the tree in this writable layer before atomic publication. Cargo
# produces the ordinary host closure once and the explicitly static worker
# closure once; every output target below shares this completed stage. The
# restricted workload client is then linked from that same exact source/build
# coordinate as a standalone external realization. It is not staged into a
# bundle and no runtime image filesystem is later mined for it.
RUN --mount=type=secret,id=publisher-key,required=true \
    --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    cp -a bundles .bundles-writable && \
    rm -rf bundles && \
    mv .bundles-writable bundles && \
    test -n "$VERSION" && \
    test -n "$SOURCE_DATE_EPOCH" && \
    test -s /run/secrets/publisher-key && \
    CARGO_TARGET_DIR=/build/target-cache \
    ./scripts/populate-bundles.sh \
      --key /run/secrets/publisher-key \
      --owner "$PUBLISHER_OWNER" \
      --bundle-set release-artifacts \
      --build-profile "$BUNDLE_BUILD_PROFILE" \
      --all && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked -p lillux -p ryeos-lillux-oci-hook && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 \
    RYEOS_BUILD_VERSION="$VERSION" \
    RYEOS_VCS_REF="$VCS_REF" \
    RYEOS_BUILD_DATE="$BUILD_DATE" \
    SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
    RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-feature=+crt-static" \
    CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --target x86_64-unknown-linux-gnu \
      -p ryeos-workload-client && \
    mkdir -p /build/target/release /out /workload-out /contained-hook-out && \
    cp /build/target-cache/release/ryeosd /build/target/release/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/release/ryeos && \
    cp /build/target-cache/release/ryeos-core-tools /build/target/release/ryeos-core-tools && \
    cp /build/target-cache/release/lillux /build/target/release/lillux && \
    ./scripts/release/package-workload-client-realization.sh \
      --version "$VERSION" \
      --source-revision "$VCS_REF" \
      --build-date "$BUILD_DATE" \
      --source-date-epoch "$SOURCE_DATE_EPOCH" \
      --target x86_64-unknown-linux-gnu \
      --binary /build/target-cache/x86_64-unknown-linux-gnu/release/ryeos-workload-client \
      --license /build/LICENSE \
      --output "/workload-out/ryeos-workload-client-${VERSION}-x86_64-unknown-linux-gnu.tar.gz" && \
    python3 scripts/release/contained-oci-hook-artifact.py package \
      --version "$VERSION" --source-revision "$VCS_REF" \
      --build-date "$BUILD_DATE" --source-date-epoch "$SOURCE_DATE_EPOCH" \
      --binary /build/target-cache/release/ryeos-lillux-oci-hook \
      --license /build/LICENSE \
      --archive "/contained-hook-out/ryeos-contained-oci-hook-${VERSION}-x86_64-unknown-linux-gnu.tar.gz"

FROM compiled-publication AS published
# Never bypass official signer admission for distributable release artifacts.
RUN --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    ./scripts/release/package-bundle-artifact.sh \
      --version "$VERSION" \
      --source /build/bundles \
      --output "/out/ryeos-bundles-${VERSION}-x86_64.tar.gz" \
      --source-date-epoch "$SOURCE_DATE_EPOCH" \
      --ryeos-bin /build/target/release/ryeos

FROM compiled-publication AS development-publication
# Local qualification must not masquerade as official publication.
RUN python3 -c 'import tomllib; from pathlib import Path; actual=tomllib.loads(Path("bundles/.ai/PUBLISHER_TRUST.toml").read_text()); expected=tomllib.loads(Path(".dev-keys/PUBLISHER_DEV_TRUST.toml").read_text()); assert actual["fingerprint"] == expected["fingerprint"]; assert actual["owner"] != "ryeos-official"'

# Every runtime image takes its binaries and bundles from the selected
# publication. Only the distributable archives below name `published`, the one
# stage that runs the official-only packaging gate.
# Composition images compile their node pair from the selected publication
# with exactly the native features their bundle set selects, so an image never
# carries a scheduler or provider-setup implementation its bundles omit.
FROM ${PUBLICATION_STAGE} AS composition-publication

# The bundle-source substrate omits the workflow bundles. Compile its node pair explicitly
# from the same source and lockfile; copying the full publication's node pair
# would retain the scheduler implementation despite omitting its bundle.
FROM composition-publication AS scheduler-free-publication
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) set -- ;; \
      latency-profiling) set -- --features ryeosd/latency-profiling ;; \
      *) exit 2 ;; \
    esac && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "$@" && \
    mkdir -p /build/target/scheduler-free && \
    cp /build/target-cache/release/ryeosd /build/target/scheduler-free/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/scheduler-free/ryeos

# Core: no optional native features.
FROM composition-publication AS core-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features core "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/core && \
    cp /build/target-cache/release/ryeosd /build/target/core/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/core/ryeos

# Core with the scheduling bundle: the scheduler, no provider setup.
FROM composition-publication AS core-scheduling-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features core-scheduling "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/core-scheduling && \
    cp /build/target-cache/release/ryeosd /build/target/core-scheduling/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/core-scheduling/ryeos

# Core with the graph bundle: graph workflows, no scheduler or provider setup.
FROM composition-publication AS core-workflow-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features core-workflow "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/core-workflow && \
    cp /build/target-cache/release/ryeosd /build/target/core-workflow/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/core-workflow/ryeos

# Core with the knowledge bundle: no scheduler or provider setup.
FROM composition-publication AS core-knowledge-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features core-knowledge "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/core-knowledge && \
    cp /build/target-cache/release/ryeosd /build/target/core-knowledge/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/core-knowledge/ryeos

# Remote-authoring controller: graph and knowledge only, no scheduler or
# directive runtime.
FROM composition-publication AS controller-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features f5r-controller "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/f5r-controller && \
    cp /build/target-cache/release/ryeosd /build/target/f5r-controller/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/f5r-controller/ryeos

# Standard: the scheduler (scheduling) and provider setup (directive) its bundles select.
FROM composition-publication AS standard-pair
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG BUNDLE_BUILD_PROFILE=release
ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    if [ -z "${CARGO_BUILD_JOBS:-}" ]; then unset CARGO_BUILD_JOBS; fi && \
    source scripts/pkg/bundle-sets.sh && \
    features=() && \
    for package in ryeosd ryeos-cli; do \
      selected="$(ryeos_bundle_set_cargo_features standard "$package")" && \
      if [ -n "$selected" ]; then features+=("$selected"); fi; \
    done && \
    case "$BUNDLE_BUILD_PROFILE" in \
      release) ;; \
      latency-profiling) features+=(ryeosd/latency-profiling) ;; \
      *) exit 2 ;; \
    esac && \
    feature_args=() && \
    if [ "${#features[@]}" -gt 0 ]; then \
      feature_args=(--features "$(IFS=,; printf '%s' "${features[*]}")"); \
    fi && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --no-default-features -p ryeosd -p ryeos-cli "${feature_args[@]}" && \
    mkdir -p /build/target/standard && \
    cp /build/target-cache/release/ryeosd /build/target/standard/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/standard/ryeos

FROM ${CONTAINED_PUBLICATION_STAGE} AS contained-publication

FROM scratch AS bundle-artifact
COPY --from=published /out/ /

FROM scratch AS workload-client-artifact
COPY --from=published /workload-out/ /

FROM scratch AS contained-oci-hook-artifact
COPY --from=contained-publication /contained-hook-out/ /

FROM node:22-trixie-slim@sha256:e6d9a389d34ff9678438af985c9913fbd1eb6ed36e80fea56644f4b4f6dd70ba AS node-runtime
RUN npm install --global npm@12.0.1 && npm cache clean --force

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS workflow-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-venv python3-pip tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/setpriv
RUN test -x /usr/bin/python3
COPY --from=node-runtime /usr/local/ /usr/local/
WORKDIR /app

# Node account. The daemon, `ryeos init` and every operator command in this
# image run as ryeos (uid 10000, gid 10000), never as root: lillux refuses
# root as the recorded actor of `ryeos node allow-restart` and
# `ryeos node capacity reissue`, so a node running as root could never have
# its restart inhibition cleared from inside its own container. tini stays
# pid 1. The entrypoint starts as root only to hand /data (a platform volume,
# mounted root-owned) to this account, then re-executes itself as ryeos
# before any ryeos command.
RUN groupadd --gid 10000 ryeos && \
    useradd --uid 10000 --gid 10000 --home-dir /data/app --no-create-home \
      --shell /bin/bash ryeos && \
    install -d -o ryeos -g ryeos -m 0750 /data /data/app

# Platform shells (Render's SSH and dashboard shell) attach as root, after
# checking that the service's running user has a login shell: the entrypoint
# drops root to the node account before the daemon starts, so that account
# carries bash above (a nologin shell makes the gateway close every session
# right after it authenticates the operator). The shell grants the account
# nothing: no password, no_new_privs, and ownership of the app root only.
# Root keeps a ~/.ssh directory with mode 0700 and a set, random, discarded
# password; the base image ships root locked, which the gateway refuses.
RUN install -d -m 0700 /root/.ssh && \
    usermod -p "$(openssl rand -base64 48 | openssl passwd -6 -stdin)" root

FROM workflow-runtime AS ryeos-standard
COPY --from=standard-pair /build/target/standard/ryeosd /usr/local/bin/ryeosd
COPY --from=standard-pair /build/target/standard/ryeos  /usr/local/bin/ryeos
COPY --from=composition-publication /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=composition-publication /build/bundles/.ai          /opt/ryeos/.ai
COPY --from=composition-publication /build/bundles/core         /opt/ryeos/core
COPY --from=composition-publication /build/bundles/scheduling /opt/ryeos/scheduling
COPY --from=composition-publication /build/bundles/knowledge /opt/ryeos/knowledge
COPY --from=composition-publication /build/bundles/directive /opt/ryeos/directive
COPY --from=composition-publication /build/bundles/graph /opt/ryeos/graph
COPY --from=composition-publication /build/bundles/ryeos-docs /opt/ryeos/ryeos-docs
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=standard
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="standard"
LABEL io.ryeos.node-uid="10000"
LABEL io.ryeos.node-gid="10000"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["python3", "-c", "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/_ryeos/ready',timeout=3).read()"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]

FROM workflow-runtime AS ryeos-local-inference
COPY --from=composition-publication /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=composition-publication /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=composition-publication /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=composition-publication /build/bundles/.ai             /opt/ryeos/.ai
COPY --from=composition-publication /build/bundles/core            /opt/ryeos/core
COPY --from=composition-publication /build/bundles/scheduling /opt/ryeos/scheduling
COPY --from=composition-publication /build/bundles/knowledge /opt/ryeos/knowledge
COPY --from=composition-publication /build/bundles/directive /opt/ryeos/directive
COPY --from=composition-publication /build/bundles/graph /opt/ryeos/graph
COPY --from=composition-publication /build/bundles/ryeos-docs /opt/ryeos/ryeos-docs
COPY --from=composition-publication /build/bundles/local-inference /opt/ryeos/local-inference
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=local-inference
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="local-inference"
LABEL io.ryeos.node-uid="10000"
LABEL io.ryeos.node-gid="10000"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
