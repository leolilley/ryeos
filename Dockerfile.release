# Hard-contained worker packaging only. An external installed Lillux adapter
# prepares /data/app and the protected authority. This target never initializes
# policy, provisions cgroups, interprets OCI metadata, or falls back to the
# ordinary hosted-workflow entry contract.
FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS ryeos-contained-workflow
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/python3
WORKDIR /app
RUN groupadd --gid 10001 ryeos-controller && \
    useradd --uid 10001 --gid 10001 --home-dir /data/app --no-create-home \
      --shell /usr/sbin/nologin ryeos-controller
COPY --from=contained-publication /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=contained-publication /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=contained-publication /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=contained-publication /build/target/release/lillux     /usr/local/bin/lillux
COPY --from=contained-publication /build/bundles/.ai          /opt/ryeos/.ai
COPY --from=contained-publication /build/bundles/core         /opt/ryeos/core
COPY --from=contained-publication /build/bundles/scheduling /opt/ryeos/scheduling
COPY --from=contained-publication /build/bundles/knowledge /opt/ryeos/knowledge
COPY --from=contained-publication /build/bundles/directive /opt/ryeos/directive
COPY --from=contained-publication /build/bundles/graph /opt/ryeos/graph
COPY --from=contained-publication /build/bundles/ryeos-docs /opt/ryeos/ryeos-docs
COPY --from=contained-publication /build/bundles/codex        /opt/ryeos/codex
COPY --from=contained-publication /build/bundles/opencode     /opt/ryeos/opencode
COPY images/contained-workflow/entrypoint.sh /usr/local/bin/contained-workflow-entrypoint
RUN chmod 0555 /usr/local/bin/contained-workflow-entrypoint && \
    test -x /usr/local/bin/lillux && \
    test -f /opt/ryeos/.ai/node/init/profiles/contained-workflow.yaml
RUN install -d -o root -g root -m 0700 /run/ryeos
ENV HOME=/data/app
ENV RYEOS_APP_ROOT=/data/app
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="contained-workflow"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
LABEL io.ryeos.required-node-profile="contained-workflow"
LABEL io.ryeos.controller-uid="10001"
LABEL io.ryeos.controller-gid="10001"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["python3", "-c", "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/_ryeos/ready',timeout=3).read()"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/contained-workflow-entrypoint"]

FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS hosted-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/setpriv
RUN test -x /usr/bin/python3
WORKDIR /app

# Node account. The daemon, `ryeos init` and every operator command in this
# image run as ryeos (uid 10000, gid 10000), never as root: lillux refuses
# root as the recorded actor of `ryeos node allow-restart` and
# `ryeos node capacity reissue`, so a node running as root could never have
# its restart inhibition cleared from inside its own container. tini stays
# pid 1. The entrypoint starts as root only to hand /data (a platform volume,
# mounted root-owned) to this account, then re-executes itself as ryeos
# before any ryeos command.
RUN groupadd --gid 10000 ryeos && \
    useradd --uid 10000 --gid 10000 --home-dir /data/app --no-create-home \
      --shell /bin/bash ryeos && \
    install -d -o ryeos -g ryeos -m 0750 /data /data/app

# Platform shells (Render's SSH and dashboard shell) attach as root, after
# checking that the service's running user has a login shell: the entrypoint
# drops root to the node account before the daemon starts, so that account
# carries bash above (a nologin shell makes the gateway close every session
# right after it authenticates the operator). The shell grants the account
# nothing: no password, no_new_privs, and ownership of the app root only.
# Root keeps a ~/.ssh directory with mode 0700 and a set, random, discarded
# password; the base image ships root locked, which the gateway refuses.
RUN install -d -m 0700 /root/.ssh && \
    usermod -p "$(openssl rand -base64 48 | openssl passwd -6 -stdin)" root

# Stable substrate for native bundle publication. This image contains only the
# bootstrap set required to run a bundle-source node. Subsequent bundle
# releases advance CAS/catalog and node-selection coordinates; they do not
# rebuild this image or replace its seed on restart.
FROM hosted-runtime AS ryeos-substrate
COPY --from=scheduler-free-publication /build/target/scheduler-free/ryeosd /usr/local/bin/ryeosd
COPY --from=scheduler-free-publication /build/target/scheduler-free/ryeos  /usr/local/bin/ryeos
COPY --from=composition-publication /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=composition-publication /build/bundles/.ai           /opt/ryeos/.ai
COPY --from=composition-publication /build/bundles/core          /opt/ryeos/core
COPY --from=composition-publication /build/bundles/bundle-source /opt/ryeos/bundle-source
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=bundle-source
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="substrate"
LABEL io.ryeos.node-uid="10000"
LABEL io.ryeos.node-gid="10000"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.bundle-seed-mode="first-boot-only"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["python3", "-c", "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/_ryeos/ready',timeout=3).read()"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]

