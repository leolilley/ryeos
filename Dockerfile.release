# syntax=docker/dockerfile:1.7
#
# One release solve owns compilation and official bundle publication. The
# native archive and every runtime image below derive from that exact published
# generation; final stages copy only their declared deployable bundle set.

FROM rust:1.95-slim@sha256:e14e87345b4d5964ddcc3491d27ee046a0f23820f340c3c1e24da6880141f7c0 AS published

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gzip openssl pkg-config libssl-dev tar xz-utils \
        libcap-dev binutils python3 python3-yaml && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

ARG VERSION
ARG SOURCE_DATE_EPOCH
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
ENV RYEOS_VCS_REF=$VCS_REF
ENV RYEOS_BUILD_DATE=$BUILD_DATE
ENV RYEOS_BUILD_VERSION=$VERSION
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH

# COPY-provided bundle directories can live in a lower overlay rename domain.
# Materialize the tree in this writable layer before atomic publication. Cargo
# produces the ordinary host closure once and the explicitly static worker
# closure once; every output target below shares this completed stage. The
# restricted workload client is then linked from that same exact source/build
# coordinate as a standalone external realization. It is not staged into a
# bundle and no runtime image filesystem is later mined for it.
RUN --mount=type=secret,id=publisher-key,required=true \
    --mount=type=cache,id=ryeos-release-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ryeos-release-cargo-target,target=/build/target-cache,sharing=locked \
    cp -a bundles .bundles-writable && \
    rm -rf bundles && \
    mv .bundles-writable bundles && \
    test -n "$VERSION" && \
    test -n "$SOURCE_DATE_EPOCH" && \
    test -s /run/secrets/publisher-key && \
    CARGO_TARGET_DIR=/build/target-cache \
    ./scripts/populate-bundles.sh \
      --key /run/secrets/publisher-key \
      --owner ryeos-official \
      --bundle-set release-artifacts \
      --build-profile "$BUNDLE_BUILD_PROFILE" \
      --all && \
    CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked -p lillux -p ryeos-lillux-oci-hook && \
    RYEOS_EXACT_BUILD_PROVENANCE=1 \
    RYEOS_BUILD_VERSION="$VERSION" \
    RYEOS_VCS_REF="$VCS_REF" \
    RYEOS_BUILD_DATE="$BUILD_DATE" \
    SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
    RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-feature=+crt-static" \
    CARGO_TARGET_DIR=/build/target-cache \
    cargo build --release --locked --target x86_64-unknown-linux-gnu \
      -p ryeos-workload-client && \
    mkdir -p /build/target/release /out /workload-out && \
    cp /build/target-cache/release/ryeosd /build/target/release/ryeosd && \
    cp /build/target-cache/release/ryeos /build/target/release/ryeos && \
    cp /build/target-cache/release/ryeos-core-tools /build/target/release/ryeos-core-tools && \
    ./scripts/release/package-bundle-artifact.sh \
      --version "$VERSION" \
      --source /build/bundles \
      --output "/out/ryeos-bundles-${VERSION}-x86_64.tar.gz" \
      --source-date-epoch "$SOURCE_DATE_EPOCH" \
      --ryeos-bin /build/target/release/ryeos && \
    ./scripts/release/package-workload-client-realization.sh \
      --version "$VERSION" \
      --source-revision "$VCS_REF" \
      --build-date "$BUILD_DATE" \
      --source-date-epoch "$SOURCE_DATE_EPOCH" \
      --target x86_64-unknown-linux-gnu \
      --binary /build/target-cache/x86_64-unknown-linux-gnu/release/ryeos-workload-client \
      --license /build/LICENSE \
      --output "/workload-out/ryeos-workload-client-${VERSION}-x86_64-unknown-linux-gnu.tar.gz"

FROM scratch AS bundle-artifact
COPY --from=published /out/ /

FROM scratch AS workload-client-artifact
COPY --from=published /workload-out/ /

FROM node:22-trixie-slim@sha256:e6d9a389d34ff9678438af985c9913fbd1eb6ed36e80fea56644f4b4f6dd70ba AS node-runtime
RUN npm install --global npm@12.0.1 && npm cache clean --force

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS workflow-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-venv python3-pip tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/python3
COPY --from=node-runtime /usr/local/ /usr/local/
WORKDIR /app

FROM workflow-runtime AS ryeos-standard
COPY --from=published /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=published /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=published /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=published /build/bundles/.ai          /opt/ryeos/.ai
COPY --from=published /build/bundles/core         /opt/ryeos/core
COPY --from=published /build/bundles/central-auth /opt/ryeos/central-auth
COPY --from=published /build/bundles/standard     /opt/ryeos/standard
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV HOME=/data/app
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=standard
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="standard"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["ryeos", "node", "status"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]

FROM workflow-runtime AS ryeos-central-host
COPY --from=published /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=published /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=published /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=published /build/bundles/.ai                   /opt/ryeos/.ai
COPY --from=published /build/bundles/core                  /opt/ryeos/core
COPY --from=published /build/bundles/central-auth          /opt/ryeos/central-auth
COPY --from=published /build/bundles/standard              /opt/ryeos/standard
COPY --from=published /build/bundles/web                   /opt/ryeos/web
COPY --from=published /build/bundles/tv-tracker-authoring  /opt/ryeos/tv-tracker-authoring
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV HOME=/data/app
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=central-host
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="central-host"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["ryeos", "node", "status"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]

# Hard-contained worker packaging only. An external installed Lillux adapter
# prepares /data/app and the protected authority. This target never initializes
# policy, provisions cgroups, interprets OCI metadata, or falls back to the
# ordinary hosted-workflow entry contract.
FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS ryeos-contained-workflow
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/python3
WORKDIR /app
RUN groupadd --gid 10001 ryeos-controller && \
    useradd --uid 10001 --gid 10001 --home-dir /data/app --no-create-home \
      --shell /usr/sbin/nologin ryeos-controller
COPY --from=published /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=published /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=published /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=published /build/target-cache/release/lillux     /usr/local/bin/lillux
COPY --from=published /build/target-cache/release/ryeos-lillux-oci-hook /usr/local/bin/ryeos-lillux-oci-hook
COPY --from=published /build/bundles/.ai          /opt/ryeos/.ai
COPY --from=published /build/bundles/core         /opt/ryeos/core
COPY --from=published /build/bundles/central-auth /opt/ryeos/central-auth
COPY --from=published /build/bundles/standard     /opt/ryeos/standard
COPY --from=published /build/bundles/hosted-node  /opt/ryeos/hosted-node
COPY --from=published /build/bundles/codex        /opt/ryeos/codex
COPY --from=published /build/bundles/opencode     /opt/ryeos/opencode
COPY images/contained-workflow/entrypoint.sh /usr/local/bin/contained-workflow-entrypoint
RUN chmod 0555 /usr/local/bin/contained-workflow-entrypoint && \
    test -x /usr/local/bin/lillux && \
    test -x /usr/local/bin/ryeos-lillux-oci-hook && \
    test -f /opt/ryeos/.ai/node/init/profiles/contained-workflow.yaml
RUN install -d -o root -g root -m 0700 /run/ryeos
ENV HOME=/data/app
ENV RYEOS_APP_ROOT=/data/app
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="contained-workflow"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
LABEL io.ryeos.required-node-profile="contained-workflow"
LABEL io.ryeos.controller-uid="10001"
LABEL io.ryeos.controller-gid="10001"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["ryeos", "node", "status"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/contained-workflow-entrypoint"]

FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS hosted-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates python3 tini && \
    rm -rf /var/lib/apt/lists/*
RUN test -x /usr/bin/tini
RUN test -x /usr/bin/python3
WORKDIR /app

FROM hosted-runtime AS ryeos-hosted-workflow
COPY --from=published /build/target/release/ryeosd           /usr/local/bin/ryeosd
COPY --from=published /build/target/release/ryeos            /usr/local/bin/ryeos
COPY --from=published /build/target/release/ryeos-core-tools /usr/local/bin/ryeos-core-tools
COPY --from=published /build/bundles/.ai          /opt/ryeos/.ai
COPY --from=published /build/bundles/core         /opt/ryeos/core
COPY --from=published /build/bundles/central-auth /opt/ryeos/central-auth
COPY --from=published /build/bundles/standard     /opt/ryeos/standard
COPY --from=published /build/bundles/hosted-node  /opt/ryeos/hosted-node
COPY --from=published /build/bundles/codex        /opt/ryeos/codex
COPY --from=published /build/bundles/opencode     /opt/ryeos/opencode
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV HOME=/data/app
ENV RYEOS_APP_ROOT=/data/app
ENV RYEOS_INIT_NODE_PROFILE=hosted-workflow
EXPOSE 8000
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG BUNDLE_BUILD_PROFILE=release
RUN test "$(/usr/local/bin/ryeosd build-info --revision)" = "$VCS_REF"
RUN test "$(/usr/local/bin/ryeosd build-info --profile)" = "$BUNDLE_BUILD_PROFILE"
LABEL org.opencontainers.image.source="https://github.com/leolilley/ryeos"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"
LABEL io.ryeos.image="hosted-workflow"
LABEL io.ryeos.bundle-protocol="1.0"
LABEL io.ryeos.build-profile="$BUNDLE_BUILD_PROFILE"
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["ryeos", "node", "status"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
