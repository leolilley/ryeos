{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RyeOS Modal sandbox lease settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspace", "lease_set", "tls_roots_der_base64"],
  "properties": {
    "schema": { "const": 1 },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9]([a-z0-9]|-[a-z0-9])*$"
    },
    "lease_set": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "tls_roots_der_base64": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 87384,
        "contentEncoding": "base64"
      }
    }
  }
}
