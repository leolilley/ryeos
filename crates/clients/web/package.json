{
  "name": "ryeos-web-client",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build:renderer": "vite build && node browser/validate-stage.mjs",
    "check:renderer": "svelte-check --tsconfig ./tsconfig.json",
    "test:renderer-root": "node tests/browser/svelte-root.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/run.mjs",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "playwright": "1.63.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "three": "0.128.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
